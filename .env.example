# Database
# Docker: set POSTGRES_PASSWORD — DB_URL is auto-built by docker-compose
POSTGRES_PASSWORD=change_this_strong_password
DB_URL=postgresql://orderflow:change_this_strong_password@localhost:5432/orderflow

# Session
SESSION_SECRET=replace-with-64-char-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Polygon / USDC (Polygon preferred, Ethereum mainnet as fallback)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MERCHANT_USDC_WALLET=0x71C7656EC7ab88b098defB751B7401B5f6d8976F

# Twilio SMS (optional — invoice and shipping links sent via SMS if patient has a phone number)
# Phone numbers stored on patients must be E.164 format (+1XXXXXXXXXX, +52XXXXXXXXXX, etc.)
# or 10-digit US numbers (auto-prefixed with +1)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# FedEx
# API credentials — also configurable in Settings → FedEx API in the admin UI
FEDEX_CLIENT_ID=your_fedex_client_id
FEDEX_CLIENT_SECRET=your_fedex_client_secret
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number
FEDEX_SANDBOX=true
# Shipper address is set in Settings → FedEx Ship From Address in the admin UI

# Email
MAIL_HOST=mail.001.com.mx
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=orders@001.com.mx
MAIL_PASS=your_smtp_password
MAIL_FROM="OrderFlow" <orders@001.com.mx>
ADMIN_EMAIL=christopher@001.com.mx

# Google Maps (address autocomplete in admin UI)
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console
# Restrict the key to HTTP referrers for your domain
# No rebuild required — key is served at runtime via GET /api/config
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App
# BASE_URL — full URL of this deployment, no trailing slash (required)
# Used in invoice/shipping emails, SMS payment links, and PDF pay URLs
BASE_URL=https://your-domain.com
# Company branding used in email footers, SMS messages, and invoice PDFs
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=billing@your-domain.com
NODE_ENV=development
PORT=3001

# File Storage
RX_STORAGE_PATH=/var/orderflow/prescriptions

# Tracking
TRACKING_POLL_INTERVAL_MINUTES=30
TRACKING_NOTIFY_OUT_FOR_DELIVERY=true

# WhatsApp (optional)
ENABLE_WHATSAPP_REMINDERS=false
WHATSAPP_API_URL=https://bot.001.com.mx/api/send

# Zoho Import
ZOHO_IMPORT_MODE=csv
# Zoho API sync (preferred over CSV — exact record linking)
# 1. https://api-console.zoho.com → Add Client → "Self Client"
# 2. Generate Code with scopes: ZohoBooks.fullaccess.READ,ZohoInventory.FullAccess.READ
# 3. curl -X POST "https://accounts.zoho.com/oauth/v2/token" \
#      -d grant_type=authorization_code -d code=CODE \
#      -d client_id=ID -d client_secret=SECRET
#    → copy refresh_token from the response
# 4. ZOHO_ORG_ID: Zoho Books → Settings (gear) → Organization → Organization ID
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Data center TLD: com | eu | in | com.au | jp (default com)
ZOHO_DC=com
